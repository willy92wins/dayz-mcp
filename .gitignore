# Credentials. The API key is generated at install time and must never be
# committed; the server refuses to start without one, so a clone creating its
# own is the intended path.
tools/.dayz_mcp.key

# Machine-local launcher registry: absolute paths and NTFS file ids. Only the
# empty baseline (approved-launchers.baseline.json) is versioned; a clone
# installs onto it.
tools/approved-launchers.json
tools/approved-launchers.lock
tools/approved-launchers.receipts/
tools/FORCE

# Built launcher bundle. Its source ships under
# tools/native-launchers/dayz-test-v1/src/; the build output is 40+ MB of
# compiled launcher and embedded CPython, sealed against the building machine.
tools/native-launchers/dayz-test-v1/*.exe
tools/native-launchers/dayz-test-v1/*.dll
tools/native-launchers/dayz-test-v1/*.pyd
tools/native-launchers/dayz-test-v1/*.zip
tools/native-launchers/dayz-test-v1/*.pyz
tools/native-launchers/dayz-test-v1/*.json
tools/native-launchers/dayz-test-v1/runtime/
tools/native-launchers/dayz-test-v1/vendor/
# Swap directories of build_native_launcher._publish_bundle; a crash can leave one.
tools/native-launchers/dayz-test-v1.incoming/
tools/native-launchers/dayz-test-v1.previous/

# Virtualenv created by install-mcp.ps1, and the packaging metadata that
# `pip install -e` leaves beside it.
tools/.venv-mcp/
*.egg-info/
build/
dist/

# Runtime state and profiles the server writes while running.
tools/_audit/
tools/reports/
_server/
_client/

__pycache__/
*.py[cod]
.pytest_cache/

# Local artefacts of the e2e harnesses under tools/_broker and tools/_session_coordination:
# per-run logs, the throwaway daemon key the broker e2e mints, result dumps and host probes.
# Only the modules the tracked tests import are versioned.
tools/_broker/*.log
tools/_broker/.e2e.key
tools/_broker/e2e_result.json
tools/_session_coordination/e2e_result.json
tools/_session_coordination/*probe*.json
tools/_session_coordination/*preflight*.json

# Default stage folder of pack-addon.ps1 when P: maps to the clone.
/temp/dayz-pack-stage/

# --- Repo hygiene (2026-09-26): backups de sesion y artefactos desechables nunca versionados ---
*.bak-*
*.bak_*
*_bak_*
*.bak
*.BEFORE
*.before
*.CANDIDATE
*.before/
*.BEFORE/
.superpowers/
out.md
_next-session*
compile.log
# Scratch dirs de sesiones y fases antiguas (todo su contenido es desechable)
/_backups/
/_compile/
/_fase1/
/_fase2/
/_fase3/
/_gamemaster_h0_build/
/_gamemaster_h0_deploy_*/
/_gamemaster_h0_release/
/_poc/
/_restore/
/_s0/
/_step0/
/tools/_delegation/
/tools/_fase4a/
/tools/_mcp_config/
/tools/_restore/
/tools/spike0/
/tools/publish/
# Logs de review gigantes (el veredicto md/json queda versionado, el log crudo no)
reviews/**/*.log
reviews/**/suite-failures*.txt
reviews/**/suite-summary.txt
reviews/**/*-hashes*.json
# Evidencias binarias pesadas
tools/fase3-evidence-*.png

reviews/**/cursor-home/
reviews/**/scratch-workspaces*/
reviews/2026-09-04-reserva/
reviews/2026-09-07-reserva-cierre/
reviews/2026-08-31-inbox-plan-grok-v1/
reviews/**/reserva*/

# Artefactos crudos voluminosos de runs de review (los md/json resumen si quedan)
reviews/**/runs/**/*.raw
reports/**/*.jsonl
reviews/**/*.png
reviews/**/*.raw
reviews/**/sessions/
