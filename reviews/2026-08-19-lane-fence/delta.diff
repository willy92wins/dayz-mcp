+class _IncrementingLauncher:
+    def __init__(self) -> None:
+        self.next_pid = 9001
+        self.calls: list[tuple[list[str], str, str, int]] = []
+        self.config_path: Path | None = None
+        self.instance_at_launch: str | None = None
