+        ("mode", RUN_ID_MATRIX_MODE_DESCRIPTION),
+        ("run_id", RUN_ID_MATRIX_RUN_ID_DESCRIPTION),
+    ):
+        prop = props.get(field)
+        if not isinstance(prop, dict):
+            raise RuntimeError(f"missing property {field} on {tool_name}")
+        prop["description"] = text
