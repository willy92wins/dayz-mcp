+
+        def request_with_refresh(
+            *,
+            method: str,
+            path: str,
+            query: dict[str, str],
+            body: bytes | None,
+            headers: dict[str, str],
+            deadline: float,
+        ) -> tuple[int, bytes]:
+            if path == "/session/enqueue":
+                return 503, json.dumps(saturated).encode("utf-8")
