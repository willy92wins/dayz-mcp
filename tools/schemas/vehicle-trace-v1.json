{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dayz-mcp-vehicle-trace-v1",
  "title": "DayZ MCP owner-client vehicle trace",
  "type": "object",
  "required": [
    "schema",
    "mode",
    "trace_id",
    "active",
    "complete",
    "overflow",
    "stop_reason",
    "sample_hz",
    "capacity",
    "count",
    "start_monotonic_s",
    "owner_identity",
    "car_type",
    "net_id_low",
    "net_id_high",
    "cursor",
    "next_cursor",
    "eof",
    "samples"
  ],
  "properties": {
    "schema": {"const": "dayz-mcp-vehicle-trace-v1"},
    "mode": {"const": "read"},
    "trace_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "active": {"type": "boolean"},
    "complete": {"type": "boolean"},
    "overflow": {"type": "boolean"},
    "stop_reason": {"type": "string"},
    "sample_hz": {"type": "integer", "minimum": 20, "maximum": 60},
    "capacity": {"type": "integer", "minimum": 2, "maximum": 8192},
    "count": {"type": "integer", "minimum": 0, "maximum": 8192},
    "start_monotonic_s": {"type": "number"},
    "owner_identity": {"type": "string"},
    "car_type": {"type": "string", "minLength": 1},
    "net_id_low": {"type": "integer"},
    "net_id_high": {"type": "integer"},
    "cursor": {"type": "integer", "minimum": 0},
    "next_cursor": {"type": "integer", "minimum": 0},
    "eof": {"type": "boolean"},
    "samples": {
      "type": "array",
      "items": {"$ref": "#/$defs/sample"}
    },
    "declared_derived": {"type": "object"}
  },
  "$defs": {
    "sample": {
      "type": "object",
      "required": [
        "sequence",
        "monotonic_s",
        "sample_dt_s",
        "forced",
        "position_x",
        "position_y",
        "position_z",
        "velocity_x",
        "velocity_y",
        "velocity_z",
        "direction_x",
        "direction_y",
        "direction_z",
        "yaw_deg",
        "pitch_deg",
        "roll_deg",
        "control_active",
        "throttle_requested",
        "steer_requested",
        "brake_requested",
        "handbrake_requested",
        "throttle_applied",
        "steer_applied",
        "brake_applied",
        "handbrake_applied",
        "wheel_contact_0",
        "wheel_contact_1",
        "wheel_contact_2",
        "wheel_contact_3",
        "wheel_angular_velocity_0",
        "wheel_angular_velocity_1",
        "wheel_angular_velocity_2",
        "wheel_angular_velocity_3",
        "wheel_count",
        "wheels_present",
        "engine_on",
        "gear",
        "is_owner",
        "is_authority_owner",
        "net_id_low",
        "net_id_high",
        "wheel_loss_event",
        "wheel_loss_count",
        "contact_count",
        "body_contact_count",
        "body_contact_zone",
        "body_contact_impulse",
        "body_contact_local_x",
        "body_contact_local_y",
        "body_contact_local_z",
        "body_contact_normal_x",
        "body_contact_normal_y",
        "body_contact_normal_z",
        "body_contact_penetration_depth"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "monotonic_s": {"type": "number"},
        "sample_dt_s": {"type": "number", "minimum": 0},
        "forced": {"type": "boolean"},
        "position_x": {"type": "number"},
        "position_y": {"type": "number"},
        "position_z": {"type": "number"},
        "velocity_x": {"type": "number"},
        "velocity_y": {"type": "number"},
        "velocity_z": {"type": "number"},
        "direction_x": {"type": "number"},
        "direction_y": {"type": "number"},
        "direction_z": {"type": "number"},
        "yaw_deg": {"type": "number"},
        "pitch_deg": {"type": "number"},
        "roll_deg": {"type": "number"},
        "control_active": {"type": "boolean"},
        "throttle_requested": {"type": "number"},
        "steer_requested": {"type": "number"},
        "brake_requested": {"type": "number"},
        "handbrake_requested": {"type": "number"},
        "throttle_applied": {"type": "number"},
        "steer_applied": {"type": "number"},
        "brake_applied": {"type": "number"},
        "handbrake_applied": {"type": "number"},
        "wheel_contact_0": {"type": "boolean"},
        "wheel_contact_1": {"type": "boolean"},
        "wheel_contact_2": {"type": "boolean"},
        "wheel_contact_3": {"type": "boolean"},
        "wheel_angular_velocity_0": {"type": "number"},
        "wheel_angular_velocity_1": {"type": "number"},
        "wheel_angular_velocity_2": {"type": "number"},
        "wheel_angular_velocity_3": {"type": "number"},
        "wheel_count": {"type": "integer", "minimum": 0},
        "wheels_present": {"type": "integer", "minimum": 0},
        "engine_on": {"type": "boolean"},
        "gear": {"type": "integer"},
        "is_owner": {"type": "boolean"},
        "is_authority_owner": {"type": "boolean"},
        "net_id_low": {"type": "integer"},
        "net_id_high": {"type": "integer"},
        "wheel_loss_event": {"type": "boolean"},
        "wheel_loss_count": {"type": "integer", "minimum": 0},
        "contact_count": {"type": "integer", "minimum": 0},
        "body_contact_count": {"type": "integer", "minimum": 0},
        "body_contact_zone": {"type": "string"},
        "body_contact_impulse": {"type": "number"},
        "body_contact_local_x": {"type": "number"},
        "body_contact_local_y": {"type": "number"},
        "body_contact_local_z": {"type": "number"},
        "body_contact_normal_x": {"type": "number"},
        "body_contact_normal_y": {"type": "number"},
        "body_contact_normal_z": {"type": "number"},
        "body_contact_penetration_depth": {"type": "number"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
